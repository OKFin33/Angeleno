# Default interaction and primary ASR language: en or zh. Chinese remains supported.
ANGELENO_LANGUAGE=en
# Generate with angeleno config; keep credentials and runtime state out of Git.
# Environment variables override this file. No shell interpolation is performed.
ANGELENO_PAID_ENABLED=0
ANGELENO_AUTHOR_PACK=characters/jo/author-pack.json
ANGELENO_AUTHOR_VARIANT=guided
ANGELENO_TIMEZONE=America/Los_Angeles
# Relative to the launch directory; an absolute path outside the checkout is supported.
ANGELENO_DATA_DIR=private/state
ANGELENO_MEMORY_USER=local-user-01
ANGELENO_MEMORY_PURPOSE=real_user
# Set to 1 for first initialization; restore 0 to reopen the same identity.
ANGELENO_MEMORY_CREATE=0
ANGELENO_MEMORY_TOOLS=1
# Optional same-writer attribution check; extra maintenance call, default off.
ANGELENO_MEMORY_ATTRIBUTION_CHECK=0
# Explicit live-source opt-in for the shared voice core; no fixture fallback.
ANGELENO_PLACE_TOOLS=0
ANGELENO_WEB_ENABLED=0
# Required when explicitly enabling web tools. This policy exports only fixed
# public IDs or explicitly public names/topics rendered as words;
# dates/persona/history/reasons stay local.
ANGELENO_WEB_EGRESS=public-fields-v1
# Cumulative Search/Fetch request cap: a positive integer, or account to use
# the configured account balance and per-turn guards. All modes keep history.
ANGELENO_WEB_REQUEST_LIMIT=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Fill from current official pricing, in currency per million tokens.
# These are accounting estimates, not claims about wallet debits.
ANGELENO_PRICE_MODEL=deepseek-flash
ANGELENO_BUDGET_CURRENCY=CNY
ANGELENO_PRICE_INPUT=
ANGELENO_PRICE_CACHE_HIT=
ANGELENO_PRICE_OUTPUT=
ANGELENO_PRICE_SOURCE=
# Explicit operator limits; 0 is allowed only when actually intended.
ANGELENO_MIN_BALANCE=
ANGELENO_BUDGET_CARRYOVER=
# ASR is metered separately. Fill a finite cumulative allowance before use.
ANGELENO_ASR_MAX_SECONDS=
DASHSCOPE_API_KEY=
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_FORCE_TCP=1
LIVEKIT_PUBLIC_URL=
ANGELENO_WEB_PORT=8767
ANGELENO_WEB_ALLOWED_ORIGINS=http://127.0.0.1:8767,http://localhost:8767
VOXCPM_URL=http://127.0.0.1:18080
VOXCPM_PREBUFFER_MS=100
# Optional bounded sentence lookahead: 0 (serial default) or 2 frames.
ANGELENO_TTS_PREFETCH_FRAMES=0
# GPU service only: operator-provided local model and private voice file.
VOXCPM_MODEL=
# Optional official torch.compile path; GPU build tools are required.
VOXCPM_COMPILE=0
VOXCPM_REFERENCE_CACHE=1
VOXCPM_REFERENCE=private/voices/reference.wav
VOXCPM_REFERENCE_PURPOSE=jo
VOXCPM_REFERENCE_ID=local-reference
VOXCPM_REFERENCE_SHA256=

# Optional private per-turn text trace; never audio or external telemetry.
# Choose a new file under ANGELENO_DATA_DIR or local private/; modes must not mix.
ANGELENO_TRACE=0
ANGELENO_TRACE_REASONING=0
# ANGELENO_DIAGNOSTICS_FILE=private/trial/operator-metadata.jsonl
